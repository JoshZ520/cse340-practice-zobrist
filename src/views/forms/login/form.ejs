<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>
        Enter your email and password to access your account. Do not have an account? <a href="/register">Register here</a>.
    </p>

    <form method="POST" action="/login" class="login-form">
        <!-- Email field -->
        <div class="form-group">
             <label for="email">Email address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com">
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" minlength="8" required pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*" placeholder="Create a password">
            <div class="help-text">Must be at least 8 characters and include a number and a special character (e.g. !@#$%^&*).</div>
        </div>

        <button type="submit" class="btn-primary">Log In</button>

        <div class="form-footer">
            <p>New user? <a href="/register">Create an account</a></p>
        </div>
    </form>
</main>
<%- include('../../partials/footer') %>